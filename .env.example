# StrafeChat - one file configures every service.
#
#   cp .env.example .env      (or run ./setup.sh, which fills in the secrets for you)
#   docker compose up -d --build
#
# Only the "Required" block needs a value. Everything else has a working default.

# =====================================================================================
# Required
# =====================================================================================

# Public hostname of this instance. DNS for it must point at this host; Caddy fetches a
# Let's Encrypt certificate automatically. This is also the instance's federation domain:
# your users are name#0001@DOMAIN to people on other instances.
DOMAIN=chat.example.com

# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.com

# Shared secret between the API and the CDN for uploads. ./setup.sh generates this, or:
#   openssl rand -hex 32
NEBULA_UPLOAD_SECRET=change-me

# =====================================================================================
# Registration
# =====================================================================================

# Close registration: only someone holding an invite code may create an account.
#
# The first account registered on a new instance is exempt - there is nobody to have issued
# an invite yet - and becomes this instance's administrator. After that, codes are made in
# Settings -> Instance, or over the API:
#
#   curl -X POST https://$DOMAIN/api/instance/invites \
#        -H "Authorization: <your token>" -H 'Content-Type: application/json' \
#        -d '{"max_uses":1,"max_age_seconds":604800,"note":"for Sam"}'
INVITE_ONLY=false

# Comma-separated user ids that may create and revoke invite codes even if the database
# does not mark them as administrators. Leave empty: the first registered account is made
# an administrator automatically. This exists so an operator who loses that account is not
# locked out of their own instance.
INSTANCE_ADMINS=

# Registration captcha. Off by default; turn it on for any instance open to the public.
CAPTCHA=false

# Which challenge to use when CAPTCHA=true. Four choices:
#
#   altcha     Self-hosted proof-of-work. Nothing to sign up for, no third-party script or
#              request, no tracking - the browser solves a small puzzle this server issued.
#              Needs only ALTCHA_HMAC_KEY (./setup.sh generates it). The default.
#   cap        Cap (trycap.dev). Also self-hosted and also proof-of-work, but as its own
#              container with a stats dashboard - worth it if you want that, or one Cap
#              shared by several apps. Set COMPOSE_PROFILES=cap to start it, then create a
#              site in its dashboard and paste the keys below.
#   friendly   Friendly Captcha (friendlycaptcha.com). Privacy-oriented hosted service with
#              a free tier; the widget is bundled with the client, so no third-party script.
#              Needs a site key and an API key from their dashboard.
#   turnstile  Cloudflare Turnstile. Free; loads Cloudflare's script in the browser.
#              Needs a site key and a secret key from the Cloudflare dashboard.
CAPTCHA_PROVIDER=altcha

# altcha: random secret of at least 32 characters, used to sign challenges.
#   openssl rand -hex 32
ALTCHA_HMAC_KEY=

# cap: the dashboard is at https://<your domain>/cap/ - sign in with CAP_ADMIN_KEY,
# create a site, and copy its two keys here. CAP_API_URL is where *browsers* solve the
# challenge, so it is the public URL; the API reaches the container directly and does not
# need changing. Requires COMPOSE_PROFILES=cap (see docker-compose.yml).
CAP_ADMIN_KEY=
CAP_SITE_KEY=
CAP_SECRET_KEY=
CAP_API_URL=https://${DOMAIN}/cap

# friendly:
FRIENDLY_CAPTCHA_SITE_KEY=
FRIENDLY_CAPTCHA_API_KEY=

# turnstile:
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =====================================================================================
# Uploads and storage
# =====================================================================================

# Per-file attachment cap in MB. Applies to the API's check and the CDN's body limit.
ATTACHMENT_MAX_MB=25

# Where uploaded files live.
#   fs   A Docker volume on this host (nebula-data). Zero configuration.
#   s3   Any S3-compatible bucket - AWS S3, Cloudflare R2, Backblaze B2, MinIO, Ceph ... -
#        for instances whose uploads outgrow a disk. Fill in the S3_* block.
STORAGE_BACKEND=fs

S3_BUCKET=
# Leave empty for AWS S3. For anything else, the service's endpoint, e.g.
#   https://<accountid>.r2.cloudflarestorage.com   (Cloudflare R2)
#   https://s3.us-west-004.backblazeb2.com          (Backblaze B2)
#   http://minio:9000                               (MinIO on the same host)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, so one bucket can be shared ("strafe/").
S3_PREFIX=
# true for MinIO and most self-hosted services (path-style addressing); false for AWS.
S3_FORCE_PATH_STYLE=false

# Browser origins allowed to fetch from the CDN. Empty = any origin, which is what lets
# users on other instances open attachments you host. Or list them:
#   https://chat.example.com,https://other.instance
NEBULA_CORS_ORIGINS=

# =====================================================================================
# Voice and video
# =====================================================================================

# Calls in PMs and group PMs and the space voice rooms run on the bundled LiveKit server
# (self-hosted, same host). The API key pair below is what the API and LiveKit share;
# ./setup.sh generates it. Leave both empty to run without voice: every call control
# disappears from the client and no ports need opening.
#   openssl rand -hex 8    -> key      openssl rand -hex 32   -> secret (32+ characters)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Media does not go through Caddy: open 7881/tcp, 50000-50200/udp and 3478/udp on the
# host firewall. LiveKit finds its public IP through STUN; on a host that cannot reach
# the internet directly, or behind a NAT that does not hairpin, pin it instead:
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=true
# Where browsers reach the signalling WebSocket. Only change this if you run LiveKit
# somewhere other than behind this Caddy (the default is wss://$DOMAIN/livekit).
LIVEKIT_URL_OVERRIDE=
# off, error, warn, info, debug
LIVEKIT_LOG_LEVEL=warn

# =====================================================================================
# Federation
# =====================================================================================

# Comma-separated domains. A non-empty allowlist means only those instances may federate;
# the blocklist refuses the listed ones. Both empty = open federation.
FEDERATION_ALLOWLIST=
FEDERATION_BLOCKLIST=

# Ed25519 signing key (base64 32-byte seed). Leave empty: one is generated on first start
# and kept in the federation-data volume. Set it only to restore an existing identity.
FEDERATION_SIGNING_KEY=

# =====================================================================================
# Tuning
# =====================================================================================

# 0-1023, unique per instance you operate - keeps generated ids from colliding.
SNOWFLAKE_NODE_ID=1

# off, error, warn, info, debug
LOG_LEVEL=info

# ScyllaDB sizing. One CPU and 1 GB is fine for a small community; give it more as you grow.
SCYLLA_SMP=1
SCYLLA_MEMORY=1G

# =====================================================================================
# Where the services are built from
# =====================================================================================

# Each service is built straight from its GitHub repository, so this directory is the only
# thing you need to clone. Change a value to build from somewhere else - a local checkout
# you are developing or patching, your own fork, or a pinned tag instead of a branch:
#
#   EQUINOX_SRC=../equinox                              a checkout beside this directory
#   EQUINOX_SRC=https://github.com/you/equinox.git#v1   your fork, at a tag
#
# ./setup.sh fills these in automatically if it finds the repositories beside this one.
# After changing any of them: docker compose up -d --build
EQUINOX_SRC=https://github.com/StrafeChat/equinox.git#dev
WEB_SRC=https://github.com/StrafeChat/web.strafe.chat.git#dev
NEBULA_SRC=https://github.com/StrafeChat/nebula.git#dev
